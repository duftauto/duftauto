<section class="{{ gridSectionClass | default('services') }}"{% if gridSectionId %} id="{{ gridSectionId }}"{% endif %}>
<div class="container">
<div class="services-head">
<span class="eyebrow">{{ gridEyebrow | default('What We Do') }}</span>
<h2>{{ gridHeading | default('Services Built Around Getting It Right') }}</h2>
</div>
<div class="services-grid">
{% for service in services %}
{% if service.slug != excludeSlug %}
<a class="service-card" href="{{ service.slug }}">
<img src="/assets/img/{{ service.img }}" alt="{{ service.alt }}">
<div class="service-card-body">
<h3>{{ service.name }}</h3>
<p>{{ service.description }}</p>
<span class="card-link">View {{ service.name }} →</span>
</div>
</a>
{% endif %}
{% endfor %}
</div>
</div>
</section>
